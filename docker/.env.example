# Copy to docker/.env (gitignored) and fill in from the secrets in the OpenShift dev namespace.
# Used by docker-compose.frontend.yml; docker compose reads it from this directory.

# ecas-api base URL. Leave empty for the default, an ecas-api port-forward from the dev namespace:
#   oc -n <namespace>-dev port-forward svc/ecas-api 8090:8080
#   (default) DYNAMICSBASEURL=http://host.docker.internal:8090/api
DYNAMICSBASEURL=

# Credentials the frontend sends to ecas-api (secret ecas-api-credentials: username, password)
DYNAMICS_USERNAME=
DYNAMICS_PASSWORD=

# Keycloak (secret ecas-frontend: keycloak-url, keycloak-realm, keycloak-clientId)
KEYCLOAK_AUTHSERVERURL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENTID=

# Laravel encryption key, local only. Generate one with:
#   docker compose -f docker/docker-compose.frontend.yml run --rm ecas-frontend php artisan key:generate --show
APP_KEY=

# Optional overrides
# APP_DEBUG=true
# APP_ENV defaults to test, the value OpenShift ends up with. local/testing registers Laravel Dusk,
# which only exists in an image built with --build-arg COMPOSER_NO_DEV=0.
# APP_ENV=test
